# Line endings: LF in every working tree, on every platform. Git normalises
# text to LF in the index and checks it out as LF, whatever core.autocrlf says.
* text=auto eol=lf

# Windows command scripts break under LF.
*.bat text eol=crlf
*.cmd text eol=crlf

# This project's own attributes (Git LFS tracking, binary or diff hints).
# A later line wins over an earlier one for the same path.
# project:begin project-attributes
# project:end project-attributes
