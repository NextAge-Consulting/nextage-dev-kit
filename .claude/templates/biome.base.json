{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"includes": [
			"**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json}",
			"!**/*.generated.*",
			"!**/*.min.js",
			"!**/*.min.mjs",
			"!**/route-tree.gen.ts",
			"!**/routeTree.gen.ts",
			"!.claude",
			"!project-documentation"
		]
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noConsole": "error"
			},
			"nursery": {
				"noExtendNative": "error",
				"noInvalidFileInputAccept": "error",
				"noMisplacedListElements": "error",
				"noNegationInEqualityCheck": "error",
				"noNonScalableViewport": "error",
				"noObsoleteTags": "error",
				"noReturnInFinally": "error",
				"noSelfImport": "error",
				"noUnmodifiedLoopCondition": "error",
				"noXorAsExponentiation": "error",
				"useControlLabel": "error",
				"usePromiseRejectErrors": "error"
			}
		}
	},
	"javascript": {
		"jsxRuntime": "transparent"
	},
	"plugins": [
		"./biome-plugins/server-fn-logging.grit",
		"./biome-plugins/no-inner-html.grit",
		"./biome-plugins/no-new-function.grit",
		"./biome-plugins/no-emoji-icon.grit",
		"./biome-plugins/no-iframe-allow-scripts.grit"
	],
	"overrides": [
		{
			"includes": [
				"**/*.test.*",
				"**/*.spec.*",
				"**/test/**",
				"**/e2e/**",
				"**/scripts/**",
				"**/*.config.*",
				"**/server-start.mjs",
				"**/server.mjs",
				"**/design-system/checks/**",
				"**/infra/**"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		}
	]
}
