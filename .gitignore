# Sensitive files
.env
*.key
*.pem
.auth_token

# The maintainer's working notes — plans, handoffs, rollout detail. The kit is public;
# what is settled lives in the docs and rules.
project-documentation/temporary/

# OS files
.DS_Store
Thumbs.db

# Claude Code per-developer state
.claude/settings.local.json
.claude/.kit-sync.json
.claude/scheduled_tasks.lock

# Build artifacts
/dist/
/build/
/out/
/*.o
/*.pyc
/*.class

# Dependency directories
/node_modules/
/vendor/

/# Logs and runtime files
*.log
*.tmp
/logs/

# IDE/Editor folders
server/public
vite.config.ts.*
*.tar.gz
.vscode
.claude/master.txt

# CPL compiled binaries (built by sync-cpl.sh)
_cpl/bin/cpl-picker
_cpl/bin/cpl-close-zed
